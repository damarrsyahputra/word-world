# Provider model: 'groq' (cloud, butuh internet)
MODEL_PROVIDER=groq

# GROQ API key (Dapatkan dari https://console.groq.com)
GROQ_API_KEY=gsk_tulis_api_key_anda_di_sini

# Origin yang diizinkan (CORS), pisahkan dengan koma.
# Default bila kosong: https://word-world-web.vercel.app
# Contoh untuk pengembangan lokal:
ALLOWED_ORIGINS=http://localhost:5173

# Supabase Storage — preview DOCX via Office Web Viewer.
# (service_role TIDAK boleh dipakai di frontend; hanya di backend/Vercel).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key